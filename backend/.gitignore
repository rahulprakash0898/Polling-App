# ==========================================
# 📦 Dependency Directories
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# 🔐 Environment Variables & Credentials
# (Never commit sensitive keys or database URLs)
# ==========================================
.env
.env.*
!.env.example
.env.production
.env.development
.env.local

# ==========================================
# 📁 Local Uploads & Temp Files
# ==========================================
uploads/*
!uploads/.gitkeep
temp/
tmp/

# ==========================================
# 📋 Logs & Debug Output
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 💻 Operating System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/